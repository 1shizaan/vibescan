{
  "name": "vibescan",
  "version": "0.1.0",
  "description": "Audit AI-generated code for security issues, duplicates, and vibe coding patterns",
  "bin": {
    "vibescan": "./dist/cli.js"
  },
  "main": "./dist/scanner.js",
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["ai", "security", "code-audit", "vibe-coding", "cli", "owasp"],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
